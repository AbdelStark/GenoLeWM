{
  "$id": "https://github.com/AbdelStark/GenoLeWM/raw/main/configs/data_v03/membership-build-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "builder": {
      "additionalProperties": false,
      "properties": {
        "container_image": {
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "geno_lewm_version": {
          "minLength": 1,
          "type": "string"
        },
        "git_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "verification": {
          "additionalProperties": false,
          "properties": {
            "container_image": {
              "const": "environment:GENO_LEWM_VERIFIED_BUILD_CONTAINER_IMAGE"
            },
            "git_commit": {"const": "git-rev-parse-head-clean-tree"}
          },
          "required": ["git_commit", "container_image"],
          "type": "object"
        }
      },
      "required": [
        "git_commit",
        "container_image",
        "geno_lewm_version",
        "verification"
      ],
      "type": "object"
    },
    "content_identity": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "runtime": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "minLength": 1,
          "type": "string"
        },
        "pyarrow_version": {
          "minLength": 1,
          "type": "string"
        },
        "python_implementation": {
          "minLength": 1,
          "type": "string"
        },
        "python_version": {
          "minLength": 1,
          "type": "string"
        },
        "sqlite_version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "python_implementation",
        "python_version",
        "platform",
        "sqlite_version",
        "pyarrow_version"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "geno-lewm.membership-build-receipt.v1"
    },
    "snapshot_lineage": {
      "additionalProperties": false,
      "properties": {
        "candidate_snapshot_id": {
          "minLength": 1,
          "type": "string"
        },
        "lineage_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "lineage_id",
        "sha256",
        "size_bytes",
        "candidate_snapshot_id"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "content_identity",
    "snapshot_lineage",
    "builder",
    "runtime",
    "created_at"
  ],
  "title": "GenoLeWM membership build receipt",
  "type": "object"
}
